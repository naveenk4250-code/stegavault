# Server Config
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/stegavault_dev?schema=public"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379"

# JWT Secret Keys
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# AWS S3 Storage
AWS_REGION="us-east-1"
S3_BUCKET_ENCRYPTED="stegavault-encrypted-files-prod"
S3_BUCKET_STEGO="stegavault-stego-keys-prod"
S3_PRESIGN_UPLOAD_TTL=300
S3_PRESIGN_DOWNLOAD_TTL=120

# OAuth Client Credentials
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/oauth/google/callback"

FACEBOOK_APP_ID="facebook-app-id"
FACEBOOK_APP_SECRET="facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/auth/oauth/facebook/callback"

DISCORD_CLIENT_ID="discord-client-id"
DISCORD_CLIENT_SECRET="discord-client-secret"
DISCORD_CALLBACK_URL="http://localhost:3000/auth/oauth/discord/callback"

# Email Provider Configuration (SES / Resend placeholder)
EMAIL_PROVIDER_API_KEY="resend-or-ses-api-key"
EMAIL_FROM_ADDRESS="noreply@stegavault.dev"

# Frontend Integration
FRONTEND_URL="http://localhost:5173"

# Argon2 Hashing Tuning (Current OWASP Recommendations)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Account Security
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_MIN=15
